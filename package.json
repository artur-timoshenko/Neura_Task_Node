{
  "name": "neura-task-hub-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "test:database": "node scripts/build-database.mjs && node test/database.test.mjs",
    "check": "npm run typecheck && npm test && npm run test:database",
    "admin:create": "node --env-file=.env scripts/create-admin.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.21.5",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "ws": "^8.18.3"
  }
}
